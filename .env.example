# Copy file nay thanh ".env" (khong co ".example") va dien so lieu that.
# KHONG commit file ".env" that len Git/chia se cong khai (chua bot token/so dien thoai).

# ---- PLC S7-1500 / PLCSIM Advanced ----
PLC_IP=192.168.0.10
PLC_RACK=0
PLC_SLOT=1
# So DB that sau khi "Generate blocks from source" trong TIA Portal (xem trong
# Program blocks, vi du "DB_VFD_Fault [DB1]" -> DB_NUMBER=1)
DB_NUMBER=1
POLL_INTERVAL_MS=500

# Nguong canh bao dong dien/nhiet do - bang dung gia tri binh thuong (vuot qua la loi):
# scl/FB_SimulateVFDFault.scl (binh thuong 8.0 A / 50.0 do C, khi loi tang lien tuc khong tran)
CURRENT_THRESHOLD_A=15.0
TEMPERATURE_THRESHOLD_C=90.0

# So thu tu webcam laptop dung de chup anh gui kem canh bao (0 = camera mac dinh)
CAMERA_INDEX=0

# ---- Telegram Bot API (bat buoc) ----
# Tao bot qua @BotFather tren Telegram de lay BOT_TOKEN. Lay CHAT_ID bang cach
# nhan tin bat ky cho bot roi mo https://api.telegram.org/bot<BOT_TOKEN>/getUpdates
# va doc truong "chat":{"id": ...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Twilio Voice (optional - de trong neu chua dung goi dien thoai that) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# ---- Termux:API (optional - rung + thong bao goc Android tren dien thoai) ----
# Dien thoai phai cai Termux (pkg install openssh, chay `sshd`) + Termux:API
# (pkg install termux-api). Neu de trong TERMUX_USER/TERMUX_PASSWORD, chuong
# trinh tu bo qua buoc nay, khong loi.
TERMUX_HOST=localhost
TERMUX_PORT=8022
TERMUX_USER=
TERMUX_PASSWORD=
# Thoi gian rung (mili giay)
TERMUX_VIBRATE_MS=1000
# Khoang cach lap lai rung+thong bao+doc canh bao (giay) trong khi loi con dang
# vuot nguong - lap lai lien tuc cho toi khi bam Reset hoac tat he thong (OFF).
# Gian cach lon hon giup giam (khong loai bo hoan toan) nguy co termux-tts-speak
# bi treo do ro ri ket noi toi dich vu TTS khi goi qua nhieu lan.
TERMUX_REPEAT_INTERVAL_SEC=300
